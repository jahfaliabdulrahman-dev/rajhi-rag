# Copy to .env and fill in. Never commit .env
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# مفتاحُ القياس (اختياريٌّ للتطبيق، **لازمٌ لأيّ قياسٍ مدفوع**): مفتاحٌ مستقلٌّ
# في OpenRouter عليه حدُّ صرفٍ بالدولار (Credit limit) = ميزانيةُ القياس التي
# أذن بها المالك ⇒ فالحدُّ يفرضه المزوّد لا حاجزٌ في الكود. والقياسُ لا يسقط إلى
# مفتاح التطبيق: بلا هذا المتغيّر يتوقّف قبل أيّ نداءٍ مدفوع.
RAJHI_EVAL_OPENROUTER_KEY=sk-or-...
