# Secrets — never commit .env
.venv/
.env
__pycache__/
*.pyc
.pytest_cache/
vectorstore/
.DS_Store

# Real bank data NEVER leaves this machine
data/local_sample/
data/training/
data/eval_pack/

# Single-job lock (transient)
data/.rajhi-job.lock

# PDFs are generated locally; only the synthetic sample is published
*.pdf
!data/sample/*.pdf
data/.amount-guard-key
data/eval_pack/amount-manifest.json
data/eval_pack/amount_redaction_map.json
docs/security/amount-denylist.json

# أثرُ تنقيحٍ لخطّاف الدفع: لا يُتتبَّع أبداً (ولا يُكتب في الشجرة أصلاً)
.hook-stdin.txt
