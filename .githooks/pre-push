#!/bin/sh
# pre-push hook — the last line of defense (what-if G3).
# Install once per clone:  git config core.hooksPath .githooks
#
# 1) publish guard — scans exactly what this push would publish.
# 2) amount guard  — the same range, against the fingerprint manifest and the
#    per-file baseline (a ratchet: declared debt passes, any INCREASE fails).
# 3) static gate   — a dev-tool gate, run LAST and never a blocker on its own:
#    blocking a push because pyflakes is missing creates the very incentive to
#    use --no-verify, which would skip the two security guards above. (review 39/4)
#
# **stdin is read ONCE.** refs arrive on stdin and the first child to read them
# consumes the stream (measured: publish_guard ate it). Captured then piped.
#
# The interpreter is looked up in this worktree, then in the MAIN checkout via
# `git rev-parse --git-common-dir` — a linked worktree has no .venv of its own.
cd "$(git rev-parse --show-toplevel)" || exit 1
COMMON=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")

PY=""
for cand in ".venv/bin/python" "$COMMON/.venv/bin/python" "python3"; do
  case "$cand" in /*) [ -x "$cand" ] && { PY="$cand"; break; };;   # مسارٌ مطلقٌ من النسخة الرئيسيّة
    *) command -v "$cand" >/dev/null 2>&1 && { PY="$cand"; break; };; esac
done
[ -n "$PY" ] || PY=python3

REFS=$(cat)
printf '%s\n' "$REFS" > "$(git rev-parse --show-toplevel)/.hook-stdin.txt"   # DEBUG: يُزال
printf '%s\n' "$REFS" | "$PY" tools/publish_guard.py --pre-push || exit 1
printf '%s\n' "$REFS" | "$PY" tools/amount_guard.py --pre-push || exit 1

if "$PY" -c "import pyflakes" 2>/dev/null; then
  "$PY" tools/static_gate.py || exit 1
else
  echo "⚠ static_gate تخطّى: لا pyflakes في $PY — أداةُ تطويرٍ غائبةٌ لا تُسقِط حرّاسَ الأمن."
fi
